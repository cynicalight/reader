{
  "name": "reader",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "dev": "node scripts/prepare-assets.mjs && node scripts/dev.mjs",
    "dev:web": "pnpm --filter @reader/web dev",
    "dev:server": "cd apps/server && go run ./cmd/reader-server",
    "build": "node scripts/prepare-assets.mjs && pnpm build:processor && pnpm build:server && pnpm --filter @reader/web build && pnpm --filter @reader/desktop build",
    "build:server": "cd apps/server && go build -o ../../apps/desktop/bin/reader-server ./cmd/reader-server",
    "desktop": "pnpm build && pnpm --filter @reader/desktop start",
    "typecheck": "tsc --noEmit",
    "test": "pnpm test:go && vitest run",
    "test:go": "cd apps/server && go test ./...",
    "api:generate": "openapi-typescript docs/openapi.yaml -o packages/api-client/src/schema.d.ts",
    "format": "prettier --write apps/web/src apps/desktop packages docs scripts",
    "postinstall": "node scripts/prepare-assets.mjs",
    "build:processor": "pnpm --filter @reader/processor build"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.19.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "jsdom": "^26.1.0",
    "openapi-typescript": "^7.10.1",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.0.0"
  }
}
